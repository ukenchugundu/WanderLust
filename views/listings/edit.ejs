<% layout("/layouts/boilerplate") %>
    <div>
        <div class="col-8 offset-2">
            <h3>Edit Listing</h3>
        
     <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation upload-form" enctype="multipart/form-data">
        <input type="hidden" name="latitude" value="<%= listing.geometry && Array.isArray(listing.geometry.coordinates) ? listing.geometry.coordinates[1] : '' %>" data-location-latitude>
        <input type="hidden" name="longitude" value="<%= listing.geometry && Array.isArray(listing.geometry.coordinates) ? listing.geometry.coordinates[0] : '' %>" data-location-longitude>
        <input type="hidden" name="mapDisplayName" value="<%= listing.mapDisplayName || '' %>" data-location-display-name>
        <div class="mb-3">
            <label for="title" class="form-label">Title:</label>
            <input type="text" id="title" name="title" value="<%= listing.title %>" class="form-control" required>
            <div class="invalid-feedback">Enter the Title...</div>
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location:</label>
            <input type="text" id="location" name="location" value="<%= listing.location %>" class="form-control" data-location-input required>
            <div class="invalid-feedback">Enter the Location...</div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description:</label>
            <textarea id="description" name="description" class="form-control" rows="4" cols="50" required><%= listing.description %></textarea>
            <div class="invalid-feedback">Enter the Description...</div>
        </div>

            <div class="row">
        <div class="mb-3 col-5">
            <label for="price" class="form-label">Price (in INR):</label>
            <input type="number" id="price" name="price" value="<%= listing.price %>" class="form-control" required>
            <div class="invalid-feedback">Enter the Price...</div>
        </div>

        <div class="mb-3 col-md-7">
            <label for="country" class="form-label">Country:</label>
            <input type="text" id="country" name="country" value="<%= listing.country %>" class="form-control" data-country-input required>
            <div class="invalid-feedback">Enter the Country...</div>
        </div>

        </div>

        <div class="form-text file-feedback location-feedback" data-location-feedback aria-live="polite">
            <%= listing.mapDisplayName ? `Saved map match: ${listing.mapDisplayName}` : '' %>
        </div>

        <div class="mb-3">
            <label class="form-label">Current Image:</label><br>
            <% if (listing.image && listing.image.url) { %>
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="img-thumbnail mb-2" style="max-width: 240px;">
            <% } %>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Upload New Image:</label>
            <input type="file" id="image" name="image" accept="image/*" class="form-control">
            <div class="form-text upload-help">Leave this empty to keep the current image.</div>
            <div class="form-text file-feedback" aria-live="polite"></div>
        </div>
        <button type="submit" class="btn btn-danger upload-submit-btn">
            <span class="default-label">Update Listing</span>
            <span class="uploading-label d-none">Uploading image...</span>
        </button>
    </form>
    <br>
    <a href="/listings" class="btn btn-secondary">Back to Listings</a> <br> <br>

</div>
    </div>
    
