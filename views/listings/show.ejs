<% layout("/layouts/boilerplate") %>
<body>
    <h3>Listing Details</h3>
    <% const imageUrl = listing.image && listing.image.url ? listing.image.url : ""; %>
  <ul>
    <li>Title: <%= listing.title %></li>
    <li>Location: <%= listing.location %></li>
    <li>Description: <%= listing.description %></li>
    <li>Price: &#8377; <%= listing.price.toLocaleString("en-IN") %></li>
    <!-- <% if (imageUrl) { %>
      <li>
        <img src="<%= imageUrl %>" alt="<%= listing.title %>" style="width: 300px; height: auto;">
      </li> -->
    <% } %>
    <li>Country: <%= listing.country %></li>
  </ul>
<br>
<a href="/listings">Back to Listings</a> <br> <br>
<a href="/listings/<%= listing._id %>/edit">Edit Listing</a> <br> <br>

<form method="POST" action="/listings/<%=listing._id %>?_method=DELETE">
    <button>Delete Listing</button>
</form>

</body>

