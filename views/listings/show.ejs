<% layout("/layouts/boilerplate") %>

    <body>
        <% const imageUrl=listing.image && listing.image.url ? listing.image.url
            : "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRI69IS84PGeSJDInvyhd8IPU8_1v3iQU0DeA&s" ; %>
            <div class="show-card-wrapper" data-realtime-listing="<%= listing._id %>">
                <h3 class="show-heading">
                    <%= listing.title %>
                </h3>

                <div class="card show-card">
                    <img src="<%= imageUrl %>" alt="<%= listing.title %>" class="card-img-top show-card-img"
                        onerror="this.onerror=null;this.src='https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRI69IS84PGeSJDInvyhd8IPU8_1v3iQU0DeA&s';">

                    <div class="card-body">
                        <% const isListingOwner = currUser && listing.owner && currUser._id.equals(listing.owner._id); %>
                        <p class="card-text"><strong>Location:</strong>
                            <%= listing.location %>, <%= listing.country %>
                        </p>
                        <% if (listing.owner) { %>
                            <p class="card-text"><strong>Hosted by:</strong> <%= listing.owner.username %></p>
                        <% } %>
                        <p class="card-text"><strong>Price:</strong> &#8377; <%= listing.price.toLocaleString("en-IN")
                                %> / night</p>
                        <p class="card-text"><strong>Description:</strong>
                            <%= listing.description %>
                        </p>
                    </div>
                </div>

                <div class="show-actions">
                    <a href="/listings" class="btn btn-dark">Back to Listings</a>
                    <% if (currUser) { %>
                        <form method="POST" action="/favorites/<%= listing._id %>/toggle" class="d-inline">
                            <button class="btn btn-outline-danger">Save to Favorites</button>
                        </form>
                    <% } %>
                    <% if (isListingOwner) { %>
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark">Edit Listing</a>

                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                            <button class="btn btn-danger">Delete Listing</button>
                        </form>
                    <% } %>
                </div>

                <% if (currUser && (!listing.owner || !currUser._id.equals(listing.owner._id))) { %>
                    <section class="booking-panel">
                        <h4>Request a stay</h4>
                        <p class="text-muted mb-0" data-availability-status>Checking live availability...</p>
                        <form action="/listings/<%= listing._id %>/bookings" method="POST" class="row g-3" data-booking-form data-nightly-price="<%= listing.price %>">
                            <div class="col-md-6"><label for="checkIn" class="form-label">Check in</label><input id="checkIn" name="checkIn" type="date" class="form-control" data-booking-date required></div>
                            <div class="col-md-6"><label for="checkOut" class="form-label">Check out</label><input id="checkOut" name="checkOut" type="date" class="form-control" data-booking-date required></div>
                            <div class="col-md-4"><label for="guests" class="form-label">Guests</label><input id="guests" name="guests" type="number" min="1" value="1" class="form-control" data-booking-guests required></div>
                            <div class="col-md-8"><label for="message" class="form-label">Message</label><input id="message" name="message" maxlength="500" class="form-control" placeholder="Tell the host about your trip"></div>
                            <div class="col-12 booking-summary" data-booking-summary>Select dates to see your estimated total.</div>
                            <div class="col-12"><button class="btn btn-dark booking-submit" data-booking-submit>Send booking request <i class="fa-solid fa-arrow-right"></i></button></div>
                        </form>
                    </section>
                <% } %>

                <section class="attractions-panel" data-attractions data-location="<%= listing.location %>" data-country="<%= listing.country %>">
                    <div class="attractions-heading"><div><p class="listing-map-kicker mb-2">Make the most of your stay</p><h4>Nearby things to do</h4></div><span class="listing-map-badge">Curated for guests</span></div>
                    <div class="attractions-grid" data-attractions-grid></div>
                </section>

                <% if (currUser) { %>
                    <section class="booking-panel">
                        <h4>Live conversation</h4>
                        <ul class="chat-messages" data-chat-messages aria-live="polite"></ul>
                        <form data-chat-form class="d-flex gap-2">
                            <input data-chat-input class="form-control" maxlength="500" placeholder="Message about this stay" required>
                            <button class="btn btn-dark">Send</button>
                        </form>
                    </section>
                <% } %>

                <section class="listing-map-section" aria-labelledby="listing-map-title">
                    <div class="listing-map-header">
                        <div>
                            <p class="listing-map-kicker mb-2">Explore the area</p>
                            <h4 id="listing-map-title" class="mb-1">Where you'll be</h4>
                            <p class="listing-map-copy mb-0">
                                <%= listing.location %>, <%= listing.country %>
                            </p>
                        </div>
                        <span class="listing-map-badge">Live location match</span>
                    </div>
                    <div id="listing-map" class="listing-map" aria-label="Map showing the listing location"></div>
                    <div class="listing-map-footer">
                        <p id="listing-map-status" class="listing-map-status text-muted mb-0">
                            Finding the best map match for this listing...
                        </p>
                        <a
                            href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(`${listing.location}, ${listing.country}`) %>"
                            class="btn btn-sm btn-outline-dark"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Open in Google Maps
                        </a>
                    </div>
                </section>

                <div class="col-8 ">
                    <br>
                    <hr>
                    <h4>Leave a Review</h4>
                    <% if (currUser) { %>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                            <div class="mb-3">
                                <label class="form-label d-block mb-2">Rating:</label>
                                <input type="hidden" name="review[rating]" class="rating-value-input" value="" required>
                                <div class="rating-picker" data-rating-picker role="group" aria-label="Choose a rating">
                                    <% for (let value = 1; value <= 5; value++) { %>
                                        <button type="button" class="rating-star-button" data-rating-value="<%= value %>" aria-label="<%= value %> star<%= value > 1 ? 's' : '' %>">
                                            ★
                                        </button>
                                    <% } %>
                                </div>
                                <div class="rating-meta">
                                    <span class="rating-caption" data-rating-caption>Select your rating</span>
                                    <button type="button" class="rating-clear-btn d-none" data-rating-clear>Clear</button>
                                </div>
                                <div class="invalid-feedback">Please select at least 1 star.</div>
                            </div>
                            <div>
                                <label for="comment" class="form-label">Comment:</label>
                                <textarea id="comment" name="review[comment]" rows="5" cols="30"
                                    class="form-control" required></textarea>
                                    <div class="invalid-feedback">Please enter valid comment...</div>
                            </div>
                            
                            <button class="btn btn-primary btn-outline-dark mt-3">Submit Review</button>
                        </form>
                    <% } else { %>
                        <p class="text-muted">Please <a href="/login">login</a> to leave a review.</p>
                    <% } %>

                    <hr>

                    <h4>All Reviews</h4>
                        <% listing.reviews.forEach((review) => { %>
                        <% const isReviewAuthor = currUser && review.author && currUser._id.equals(review.author._id); %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="review-rating-row mb-2">
                                    <p class="review-stars-display mb-0" aria-label="Rated <%= review.rating %> out of 5">
                                        <% for (let value = 1; value <= 5; value++) { %>
                                            <span class="<%= value <= review.rating ? 'review-star-filled' : 'review-star-empty' %>">★</span>
                                        <% } %>
                                    </p>
                                    <span class="review-rating-badge"><%= review.rating %>.0</span>
                                    <span class="review-rating-label">
                                        <%= review.rating === 1 ? 'Poor' : review.rating === 2 ? 'Fair' : review.rating === 3 ? 'Good' : review.rating === 4 ? 'Very good' : 'Excellent' %>
                                    </span>
                                </div>
                                <% if (review.author) { %>
                                    <p class="card-text text-muted mb-2">By <%= review.author.username %></p>
                                <% } %>
                                <p class="card-text"><%= review.comment %></p>
                                <% if (isReviewAuthor) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-danger">Delete Review</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <script>
                window.addEventListener('load', () => {
                    const listingTitle = <%- JSON.stringify(listing.title) %>;
                    const locationLabel = <%- JSON.stringify(`${listing.location}, ${listing.country}`) %>;
                    const savedMapDisplayName = <%- JSON.stringify(listing.mapDisplayName || '') %>;
                    const savedCoordinates = <%- JSON.stringify(
                        listing.geometry && Array.isArray(listing.geometry.coordinates) && listing.geometry.coordinates.length === 2
                            ? [listing.geometry.coordinates[1], listing.geometry.coordinates[0]]
                            : null
                    ) %>;
                    const mapElement = document.getElementById('listing-map');
                    const statusElement = document.getElementById('listing-map-status');

                    if (!mapElement || typeof L === 'undefined') {
                        if (statusElement) {
                            statusElement.textContent = 'Map could not be loaded right now.';
                        }
                        return;
                    }

                    const map = L.map(mapElement, {
                        scrollWheelZoom: false,
                        zoomControl: true,
                    }).setView([20.5937, 78.9629], 4);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors',
                        maxZoom: 19,
                    }).addTo(map);

                    const addMarker = (latitude, longitude, resolvedLabel = locationLabel) => {
                        map.setView([latitude, longitude], 13);

                        const listingMarker = L.divIcon({
                            className: 'listing-map-pin-wrapper',
                            html: '<span class="listing-map-pin"></span>',
                            iconSize: [26, 26],
                            iconAnchor: [13, 26],
                            popupAnchor: [0, -22],
                        });

                        L.circle([latitude, longitude], {
                            radius: 260,
                            color: '#fe424d',
                            weight: 1.5,
                            fillColor: '#fe424d',
                            fillOpacity: 0.12,
                        }).addTo(map);

                        L.marker([latitude, longitude], {
                            icon: listingMarker,
                        })
                            .addTo(map)
                            .bindPopup(`
                                <div class="listing-map-popup">
                                    <p class="listing-map-popup-label">Stay location</p>
                                    <h6>${listingTitle}</h6>
                                    <p>${resolvedLabel}</p>
                                </div>
                            `)
                            .openPopup();

                        setTimeout(() => map.invalidateSize(), 0);
                    };

                    if (
                        Array.isArray(savedCoordinates) &&
                        savedCoordinates.length === 2 &&
                        savedCoordinates.every((value) => Number.isFinite(value))
                    ) {
                        addMarker(savedCoordinates[0], savedCoordinates[1], savedMapDisplayName || locationLabel);

                        if (statusElement) {
                            statusElement.textContent = `Showing the saved map location for ${savedMapDisplayName || locationLabel}.`;
                        }
                        return;
                    }

                    const geocodeUrl = `https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q=${encodeURIComponent(locationLabel)}`;

                    fetch(geocodeUrl, {
                        headers: {
                            Accept: 'application/json',
                        },
                    })
                        .then((response) => {
                            if (!response.ok) {
                                throw new Error('Geocoding request failed');
                            }
                            return response.json();
                        })
                        .then((results) => {
                            if (!Array.isArray(results) || results.length === 0) {
                                throw new Error('No map match found');
                            }

                            const match = results[0];
                            const latitude = Number(match.lat);
                            const longitude = Number(match.lon);

                            if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
                                throw new Error('Invalid coordinates received');
                            }

                            addMarker(latitude, longitude, match.display_name || locationLabel);

                            if (statusElement) {
                                statusElement.textContent = `Showing the closest matched spot for ${match.display_name || locationLabel}.`;
                            }
                        })
                        .catch(() => {
                            if (statusElement) {
                                statusElement.textContent = `We couldn't find an exact map match for ${locationLabel} right now.`;
                            }
                        });
                });
            </script>

    </body>
