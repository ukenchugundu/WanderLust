<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Create New Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation upload-form" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <input type="text" id="title" name="title" placeholder="enter title" class="form-control" required>
                   
                    <div class="invalid-feedback">Enter the Title...</div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location:</label>
                    <input type="text" id="location" name="location" placeholder="enter location" class="form-control"
                        required>
                    <div class="invalid-feedback">Enter the Location...</div>
                </div>


                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label><br>
                    <textarea id="description" name="description" placeholder="enter description" class="form-control"
                        rows="4" cols="50" required></textarea>
                    <div class="invalid-feedback">Enter the Description...</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-5">
                        <label for="price" class="form-label">Price (in INR):</label>
                        <input  id="price" name="price" placeholder="enter price" class="form-control"
                            min="0" step="any" required>
                        <div class="invalid-feedback">Enter a valid numeric price...</div>
                    </div>

                    <div class="mb-3 col-md-7">
                        <label for="country" class="form-label">Country:</label>
                        <input type="text" id="country" name="country" placeholder="enter country" class="form-control"
                            required>
                        <div class="invalid-feedback">Enter the Country...</div>
                    </div>

                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image:</label>
                    <input type="file" id="image" name="image" accept="image/*" class="form-control">
                    <div class="form-text upload-help">Upload a JPG, PNG, WEBP, or AVIF image up to 5MB.</div>
                    <div class="form-text file-feedback" aria-live="polite"></div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-danger upload-submit-btn">
                        <span class="default-label">Create Listing</span>
                        <span class="uploading-label d-none">Uploading image...</span>
                    </button>
                </div>

            </form>
        </div>
    </div>
