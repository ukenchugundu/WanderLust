<% layout('/layouts/boilerplate') %>
<section class="account-shell">
  <p class="listing-index-kicker">Host workspace</p>
  <h1 class="listing-index-title">Dashboard</h1>
  <div class="dashboard-section"><div class="listing-index-header"><h2>Your listings</h2><a href="/listings/new" class="listing-search-clear">Add listing</a></div>
    <% if (listings.length === 0) { %><p class="text-muted">You have not created a listing yet.</p><% } else { %>
      <div class="dashboard-list"> <% listings.forEach((listing) => { %><a href="/listings/<%= listing._id %>"><strong><%= listing.title %></strong><span><%= listing.location %> · &#8377; <%= listing.price.toLocaleString('en-IN') %></span></a><% }) %></div>
    <% } %>
  </div>
  <div class="dashboard-section"><h2>Incoming booking requests</h2>
    <% if (incomingBookings.length === 0) { %><p class="text-muted">No booking requests yet.</p><% } %>
    <% incomingBookings.forEach((booking) => { %><article class="booking-row"><div><strong><%= booking.listing?.title || 'Listing' %></strong><p><%= booking.guest?.username || 'Guest' %> · <%= booking.checkIn.toLocaleDateString() %> to <%= booking.checkOut.toLocaleDateString() %> · <%= booking.guests %> guest(s)</p></div><span class="booking-status"><%= booking.status %></span><% if (booking.status === 'pending') { %><form method="POST" action="/bookings/<%= booking._id %>?_method=PATCH"><button name="status" value="approved" class="btn btn-sm btn-dark">Approve</button><button name="status" value="declined" class="btn btn-sm btn-outline-danger">Decline</button></form><% } %></article><% }) %>
  </div>
  <div class="dashboard-section"><h2>Your booking requests</h2><% if (outgoingBookings.length === 0) { %><p class="text-muted">No booking requests sent.</p><% } %><% outgoingBookings.forEach((booking) => { %><p><strong><%= booking.listing?.title || 'Listing' %></strong> · <%= booking.status %></p><% }) %></div>
</section>
