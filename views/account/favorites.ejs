<% layout('/layouts/boilerplate') %>
<section class="account-shell">
  <p class="listing-index-kicker">Your collection</p>
  <h1 class="listing-index-title">Saved favorites</h1>
  <% if (favorites.length === 0) { %>
    <section class="listing-empty-state"><h2>No favorites yet.</h2><p>Save listings you want to revisit.</p><a href="/listings" class="listing-search-clear">Browse listings</a></section>
  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
      <% favorites.forEach((listing) => { %>
        <a href="/listings/<%= listing._id %>" class="text-decoration-none">
          <div class="card"><img src="<%= listing.image?.url %>" class="card-img-top" alt="<%= listing.title %>"><div class="card-body"><p class="card-text"><%= listing.title %></p><p class="card-text">&#8377; <%= listing.price.toLocaleString('en-IN') %> / night</p></div></div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
