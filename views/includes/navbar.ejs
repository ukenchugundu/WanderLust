<nav class="navbar wander-navbar navbar-expand-md sticky-top">
    <% const user = typeof currUser === "undefined" ? null : currUser; %>
    <div class="container wander-navbar-inner">
        <a class="navbar-brand wander-brand" href="/" aria-label="WanderLust home">
            <span class="wander-brand-mark"><i class="fa-regular fa-compass"></i></span>
            <span><strong>Wander</strong><em>Lust</em><small>stay curious</small></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <i class="fa-solid fa-bars"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav wander-nav-links">
                <a class="nav-link" aria-current="page" href="/">Discover</a>
                <a class="nav-link" href="/listings">Stays</a>
                <a class="nav-link" href="/services">Services</a>
                <a class="nav-link" href="/contact">Contact</a>
                <% if (user) { %>
                    <a class="nav-link" href="/favorites"><i class="fa-regular fa-heart"></i> Saved</a>
                <% } %>
            </div>

            <div class="wander-nav-account ms-auto">
