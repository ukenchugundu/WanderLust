                    <a class="wander-account" href="/dashboard" aria-label="Open account dashboard">
                        <span class="wander-avatar"><%= user.username.slice(0, 1).toUpperCase() %></span>
                        <span class="wander-account-name"><%= user.username %></span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </a>
                    <a class="wander-logout" href="/logout">Log out</a>
                <% } else { %>
                    <a class="wander-host-link" href="/listings/new">List your place</a>
